CELERY_BROKER_URL=redis://localhost:6379/1
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_URL=smtp://localhost:1025
SECRET_KEY=changeme
HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=True
DASHBOARD_URL=http://localhost:9000/

# PrintMe worker placeholders. Leave secrets empty. Real keys belong only in
# printme.env, mounted on the inbound process. The worker polls only when the
# address, bucket, queue, From address, region, AWS keys, and Fernet key are
# set and PRINTME_EMAIL_BACKEND=ses. The bucket setting is PRINTME_S3_BUCKET.
# Planned S3 lifecycle, created in AWS and not by this app: expire
# raw/inbound/ after 7 days and raw/documents/ after 7 days.
PRINTME_INBOUND_ADDRESS=print@in.bavasim.com
PRINTME_S3_BUCKET=your-printme-bucket
PRINTME_S3_PREFIX=raw/
PRINTME_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/printme-inbound
PRINTME_SES_FROM_ADDRESS=noreply@bavasim.com
PRINTME_EMAIL_BACKEND=ses
PRINTME_AWS_REGION=us-east-1
PRINTME_AWS_ACCESS_KEY_ID=
PRINTME_AWS_SECRET_ACCESS_KEY=
PRINTME_MAX_BYTES=20971520
PRINTME_CODE_TTL_HOURS=24
PRINTME_MAX_VERIFY_ATTEMPTS=5
PRINTME_CODE_KEY=
