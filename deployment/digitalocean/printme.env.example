# Loaded only by the PrintMe inbound process. Do not put these values in the
# shared Saleor .env. Placeholders only: leave every secret empty until AWS
# is configured. The worker refuses to poll unless PRINTME_INBOUND_ADDRESS,
# PRINTME_S3_BUCKET, PRINTME_SQS_QUEUE_URL, PRINTME_SES_FROM_ADDRESS,
# PRINTME_AWS_REGION, PRINTME_AWS_ACCESS_KEY_ID, PRINTME_AWS_SECRET_ACCESS_KEY,
# and PRINTME_CODE_KEY are set, and PRINTME_EMAIL_BACKEND is ses.
# Planned S3 lifecycle, created in AWS and not by this app: expire
# raw/inbound/ after 7 days and raw/documents/ after 7 days.
PRINTME_INBOUND_ADDRESS=print@in.bavasim.com
PRINTME_S3_BUCKET=your-printme-bucket
PRINTME_S3_PREFIX=raw/
PRINTME_SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/696073197862/printme-email-queue
PRINTME_SES_FROM_ADDRESS=noreply@bavasim.com
PRINTME_EMAIL_BACKEND=ses
PRINTME_AWS_REGION=us-east-1
PRINTME_AWS_ACCESS_KEY_ID=
PRINTME_AWS_SECRET_ACCESS_KEY=
PRINTME_MAX_BYTES=20971520
PRINTME_CODE_TTL_HOURS=24
PRINTME_MAX_VERIFY_ATTEMPTS=5
PRINTME_CODE_KEY=
