# Copy to .env on the server and fill in secrets.
# Never commit the real .env.

# --- Django / Saleor ---
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=server.chapchapticket.com,127.0.0.1,localhost
# Comma-separated hosts allowed as GraphQL clients (no scheme). Use * only for early bring-up.
ALLOWED_CLIENT_HOSTS=server.chapchapticket.com,localhost,127.0.0.1
# Use http + ENABLE_SSL=False until Certbot succeeds, then switch to https + True.
PUBLIC_URL=https://server.chapchapticket.com/
ENABLE_SSL=False
DASHBOARD_URL=https://dashboard.chapchapticket.com/
DEFAULT_FROM_EMAIL=noreply@chapchapticket.com
EMAIL_URL=smtp://user:pass@smtp.example.com:587/
HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=False

# --- Database: existing host Postgres on the droplet (DB name chapchap) ---
# From containers, reach the host via host.docker.internal (see compose extra_hosts).
DATABASE_URL=postgres://vaflaly:CHANGE_ME@host.docker.internal:5432/chapchap
# POSTGRES_* only needed if you later enable a compose db service.
POSTGRES_USER=saleor
POSTGRES_PASSWORD=unused
POSTGRES_DB=saleor

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/0

# --- Media / static URLs (served by host Nginx) ---
MEDIA_URL=/media/
STATIC_URL=/static/

# --- Twilio (copy from local saleor/.env) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VERIFY_SERVICE_SID=

# Guichet SLA: minutes before unpaid-confirm MoMo bookings auto-refund.
# Feature is OFF unless GUICHET_AUTO_EXPIRE_ENABLED=true (then recreate api/worker/beat).
GUICHET_AUTO_EXPIRE_ENABLED=false
GUICHET_CONFIRM_TIMEOUT_MINUTES=15
BEAT_GUICHET_TIMEOUT_SCHEDULE=1 minute

# RSA keys are loaded from secrets/*.pem by entrypoint.sh — do not paste PEM here.
